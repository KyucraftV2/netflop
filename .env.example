# =============================================================================
# Netflop — configuration (copier en .env, ne JAMAIS commiter .env)
#   cp .env.example .env && chmod 600 .env
# Les valeurs <...> sont à remplir avant le premier lancement.
# =============================================================================

# --- Domaine et Traefik -------------------------------------------------------
# Domaine public du hub.
HUB_DOMAIN=<HUB_DOMAIN>
# Réseau Docker externe sur lequel tourne Traefik (voir : docker network ls).
TRAEFIK_NETWORK=<TRAEFIK_NETWORK>
# Point d'entrée HTTPS de Traefik (nom défini dans la config statique de Traefik).
TRAEFIK_ENTRYPOINT=websecure
# Résolveur de certificats Let's Encrypt de Traefik.
CERT_RESOLVER=myresolver

# --- Authentik / Auth.js (utilisés à partir de l'étape 2) ---------------------
# URL publique d'Authentik, sans slash final (ex. https://auth.example.com).
AUTHENTIK_URL=https://<AUTHENTIK_DOMAIN>
# Issuer OIDC du provider « netflop » (slash final obligatoire).
AUTH_AUTHENTIK_ISSUER=https://<AUTHENTIK_DOMAIN>/application/o/netflop/
# Client ID / secret du provider OAuth2 « netflop » dans Authentik.
AUTH_AUTHENTIK_ID=<CLIENT_ID>
AUTH_AUTHENTIK_SECRET=<CLIENT_SECRET>
# Secret de chiffrement Auth.js : openssl rand -base64 33
AUTH_SECRET=<GENERER_AVEC_OPENSSL>
# URL publique du hub et confiance dans les en-têtes X-Forwarded-* de Traefik.
AUTH_URL=https://<HUB_DOMAIN>
AUTH_TRUST_HOST=true

# --- Base de données ----------------------------------------------------------
# Mot de passe Postgres : openssl rand -hex 24
# DATABASE_URL est construite automatiquement par docker-compose.yml à partir de ce mot de passe :
#   postgresql://netflop:${POSTGRES_PASSWORD}@db:5432/netflop
POSTGRES_PASSWORD=<GENERER_AVEC_OPENSSL>

# --- Navigateurs Neko ---------------------------------------------------------
# IPv4 publique de la machine, ou de la box derrière un NAT (annoncée aux clients
# WebRTC) : curl -4 ifconfig.me
PUBLIC_IP=<PUBLIC_IP>
# Un port par navigateur actif, publié en UDP (+ TCP de secours) sur l'hôte.
SLOT_PORTS=52000,52001,52002
# Nombre max de navigateurs simultanés (~1,5 Go de RAM chacun).
MAX_ACTIVE_BROWSERS=3
# Codec vidéo : h264 (recommandé, indispensable pour Safari/iOS) ou vp8.
BROWSER_VIDEO_CODEC=h264
# Image des navigateurs : publiée sur GHCR (docker compose --profile build pull browser-image)
# ou construite en local (docker compose --profile build build browser-image).
BROWSER_IMAGE=ghcr.io/kyucraftv2/netflop-browser:latest
# Image du hub et du worker (publiée sur GHCR ; `docker compose build` pour un build local).
# Pour une version précise : ghcr.io/kyucraftv2/netflop-hub:0.2.0
HUB_IMAGE=ghcr.io/kyucraftv2/netflop-hub:latest

# --- Réseaux (valeurs par défaut adaptées dans 99 % des cas) -----------------
# Réseau DÉDIÉ aux navigateurs : Traefik doit y être connecté (voir README).
BROWSER_NETWORK=netflop-browsers
# Préfixe /24 de ce réseau : .2 hub, .3 worker, .10+slot navigateurs, .128+ automatique.
BROWSER_SUBNET_PREFIX=172.30.250
DOCKER_PROXY_URL=http://docker-proxy:2375

# --- Cycle de vie (étape 3) ---------------------------------------------------
# Sans heartbeat depuis N secondes : le navigateur est arrêté.
HEARTBEAT_TIMEOUT_SECONDS=60
# Popup « Tu regardes toujours ? » après N heures sans interaction.
STILL_WATCHING_HOURS=4

# --- Catalogue (étape 4) ------------------------------------------------------
# Clé API TMDB (v3), côté serveur uniquement : https://www.themoviedb.org/settings/api
TMDB_API_KEY=<TMDB_API_KEY>
# Liens directs vers les titres via l'API non officielle de JustWatch.
JUSTWATCH_ENABLED=true

# --- Suivi de visionnage (étape 5) --------------------------------------------
# Fréquence de lecture de l'état des navigateurs.
TRACKER_INTERVAL_SECONDS=30
# Vidéo en pause depuis N minutes : navigateur arrêté (progression enregistrée).
PAUSED_STOP_MINUTES=30

# --- Divers -------------------------------------------------------------------
# debug | info
LOG_LEVEL=info

# --- Image navigateur ---------------------------------------------------------
# 1 = liste blanche d'URL dans Chrome (Netflix, Canal+, france.tv uniquement).
# À activer après avoir vérifié la lecture (un CDN manquant bloquerait la vidéo).
NETFLOP_URL_ALLOWLIST=0
# URL de l'API TMDB (à ne changer que pour les tests).
# TMDB_API_BASE_URL=https://api.themoviedb.org
